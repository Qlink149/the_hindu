# The Hindu Sales Intelligence — environment template
# Copy to backend/.env and fill in values.

MONGO_URL=
DB_NAME=hindu_db
SECRET_KEY=change-me

# Bolna Voice AI (primary calling engine)
# Dashboard: https://platform.bolna.ai  Docs: https://www.bolna.ai/docs
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_PHONE=
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_WEBHOOK_SECRET=

# Webhook URL to set on the Bolna agent (Extractions tab):
#   https://<your-api-host>/api/webhooks/bolna

# Optional LLM
OPENAI_API_KEY=
GROQ_API_KEY_1=

# Optional. Original CSVs are stored in Mongo. Set this only if you also want
# Cloudinary as a secondary copy.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
